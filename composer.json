{
    "name":  "laravel/laravel",
    "type":  "project",
    "description":  "The Laravel Framework.",
    "keywords":  [
                     "framework",
                     "laravel"
                 ],
    "license":  "MIT",
    "repositories":  [
                         {
                             "type":  "path",
                             "url":  "packages/laravel-payhere"
                         }
                     ],
    "require":  {
        "php": "^8.3",
        "anandsiddharth/laravel-paytm-wallet": ">=2",
        "anhskohbo/no-captcha": ">=3.8",
        "arkitecht/laravel-twilio": ">=1.7",
        "barryvdh/laravel-dompdf": ">=3.1.2",
        "coingate/coingate-php": ">=4.1",
        "doctrine/dbal": ">=4.6",
        "fedapay/fedapay-php": ">=0.4.9",
        "geoip2/geoip2": ">=3.4",
        "guzzlehttp/guzzle": ">=7.16.3",
        "iyzico/iyzipay-php": ">=2.0.64",
        "kkomelin/laravel-translatable-string-exporter": ">=1.26",
        "lab404/laravel-impersonate": ">=1.7.8",
        "lahirulhr/laravel-payhere": "^0.2.1",
        "laravel/framework": "^13.43",
        "laravel/sanctum": ">=4.5",
        "laravel/tinker": ">=3.2",
        "league/flysystem-aws-s3-v3": ">=3.35.3",
        "maatwebsite/excel": ">=4.0.7",
        "mashape/unirest-php": ">=3.0.4",
        "mercadopago/dx-php": ">=3.16",
        "midtrans/midtrans-php": ">=2.6.2",
        "milon/barcode": ">=13.6",
        "mollie/mollie-api-php": ">=4.1",
        "munafio/chatify": "1.6.4",
        "nwidart/laravel-modules": ">=13.3",
        "obydul/laraskrill": ">=1.2",
        "orhanerday/open-ai": ">=6.3.1",
        "paymentwall/paymentwall-php": ">=2.2.4",
        "paytabs/laravel-sdk": "^3.0",
        "psr/simple-cache": "^3.0",
        "rdx/laravelcollective-html": ">=6.10",
        "spatie/laravel-google-calendar": ">=3.8.5",
        "spatie/laravel-permission": ">=8.5",
        "srmklive/paypal": ">=3.2",
        "stripe/stripe-php": ">=23",
        "whichbrowser/parser": ">=2.1.8",
        "xendit/xendit-php": ">=7",
        "yoomoney/yookassa-sdk-php": ">=3.16"
    },
    "require-dev":  {
                        "barryvdh/laravel-debugbar":  ">=4.4.5",
                        "fakerphp/faker":  ">=1.24.1",
                        "laravel/breeze":  ">=2.4.2",
                        "laravel/sail":  ">=1.71",
                        "mockery/mockery":  ">=1.6.15",
                        "nunomaduro/collision":  ">=8.9.6",
                        "phpunit/phpunit":  ">=13.4.7",
                        "spatie/laravel-ignition":  ">=2.13"
                    },
    "autoload":  {
                     "psr-4":  {
                                   "App\\":  "app/",
                                   "Database\\Factories\\":  "database/factories/",
                                   "Database\\Seeders\\":  "database/seeders/",
                                   "Modules\\":  "Modules/"
                               }
                 },
    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/"
                                   }
                     },
    "scripts":  {
                    "post-autoload-dump":  [
                                               "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                                               "@php artisan package:discover --ansi"
                                           ],
                    "post-update-cmd":  [
                                            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                                        ],
                    "post-root-package-install":  [
                                                      "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\""
                                                  ],
                    "post-create-project-cmd":  [
                                                    "@php artisan key:generate --ansi"
                                                ]
                },
    "extra":  {
                  "laravel":  {
                                  "dont-discover":  [

                                                    ]
                              }
              },
    "config":  {
                   "optimize-autoloader":  true,
                   "preferred-install":  "dist",
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "wikimedia/composer-merge-plugin":  true
                                     }
               },
    "minimum-stability":  "dev",
    "prefer-stable":  true
}
